{
  "name": "agentic-setup",
  "version": "0.1.0",
  "description": "Reversible installer for a curated coding-agent setup",
  "keywords": ["claude-code", "codex", "gemini-cli", "agent-skills", "installer", "ai-agents"],
  "author": "Prayush Kale",
  "homepage": "https://github.com/prayushkale/agentic-setup#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prayushkale/agentic-setup.git"
  },
  "bugs": "https://github.com/prayushkale/agentic-setup/issues",
  "type": "module",
  "bin": {
    "agentic-setup": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "files": [
    "dist",
    "assets",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "node ../tools/bundle-assets.mjs && cp ../README.md ../LICENSE ../CHANGELOG.md . && npm run build",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "execa": "^9.6.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
